#!/usr/bin/env bash
# pvm24 — Run a .p24 bytecode file on the COR24 P-Code VM
#
# Usage:
#   pvm24 <file.p24> [options]
#   pvm24 --spc <file.spc>              Assemble .spc then run
#   pvm24 --link <file.spc>...          Link + assemble + run (multi-unit)
#
# Options passed through to cor24-run:
#   -n <count>       Max instructions (default: 50000000)
#   --terminal       Interactive UART mode
#   -u <str>         Preload UART input
#   --speed <ips>    Instructions per second (0 = max)
set -euo pipefail

LIBDIR="/disk1/github/softwarewrighter/devgroup/work/lib/pcode"
PVM="$LIBDIR/pvm.s"
PVMASM="$LIBDIR/pvmasm.s"
MAX_INSN=50000000

die() { echo "pvm24: $*" >&2; exit 1; }

[ $# -ge 1 ] || die "usage: pvm24 <file.p24> | --spc <file.spc> | --link <files.spc...>"

MODE="p24"
FILES=()
EXTRA_ARGS=()
VERBOSE=false

while [ $# -gt 0 ]; do
  case "$1" in
    --spc)     MODE="spc"; shift; FILES+=("$1"); shift ;;
    --link)    MODE="link"; shift
               while [ $# -gt 0 ] && [[ ! "$1" == -* ]]; do
                 FILES+=("$1"); shift
               done ;;
    -n)        MAX_INSN="$2"; shift 2 ;;
    --verbose|-v) VERBOSE=true; shift ;;
    --terminal|--echo|--dump) EXTRA_ARGS+=("$1"); shift ;;
    --speed|-s) EXTRA_ARGS+=("$1" "$2"); shift 2 ;;
    -u)        EXTRA_ARGS+=("$1" "$2"); shift 2 ;;
    -*)        die "unknown option: $1" ;;
    *)         FILES+=("$1"); shift ;;
  esac
done

[ ${#FILES[@]} -ge 1 ] || die "no input file specified"

filter_output() {
  if $VERBOSE; then
    cat
  else
    grep -v '^\[UART' | grep -v '^\[CPU ' | grep -v '^Assembled' | \
    grep -v '^Running' | grep -v '^Executed' | grep -v '^Loaded' | \
    grep -v '^Patched' | grep -v '^Entry point:' | \
    grep -v '^PVM OK' | grep -v '^UART output: PVM OK' | \
    grep -v '^CPU halted' | grep -v '^HALT$' | \
    grep -v '^RUN$' | grep -v '^$' | \
    sed 's/^UART output: //'
  fi
}

case "$MODE" in
  spc)
    # Single .spc: use pvmasm.s (integrated assembler+VM)
    INPUT="${FILES[0]}"
    [ -f "$INPUT" ] || die "file not found: $INPUT"
    cor24-run --run "$PVMASM" -u "$(cat "$INPUT")"$'\x04' \
      --speed 0 -n "$MAX_INSN" "${EXTRA_ARGS[@]}" 2>&1 | filter_output
    ;;

  link)
    # Multi-unit: assemble each .spc, link, load on pvm.s
    TMP=$(mktemp -d)
    trap "rm -rf $TMP" EXIT

    P24_FILES=()
    for f in "${FILES[@]}"; do
      [ -f "$f" ] || die "file not found: $f"
      base=$(basename "$f" .spc)
      pa24r "$f" -o "$TMP/${base}.p24" 2>/dev/null || die "pa24r failed on $f"
      P24_FILES+=("$TMP/${base}.p24")
    done

    p24-load "${P24_FILES[@]}" -o "$TMP/image.p24m" 2>/dev/null || die "p24-load failed"

    # Assemble PVM and find code_ptr
    cor24-run --assemble "$PVM" "$TMP/pvm.bin" "$TMP/pvm.lst" >/dev/null 2>&1
    CODE_PTR=$(grep -A1 "code_ptr:" "$TMP/pvm.lst" | tail -1 | awk '{print $1}' | tr -d ':')
    [ -n "$CODE_PTR" ] || die "could not resolve code_ptr from pvm.lst"

    cor24-run --load-binary "$TMP/pvm.bin@0" \
      --load-binary "$TMP/image.p24m@0x010000" \
      --patch "0x${CODE_PTR}=0x010000" \
      --entry 0 --speed 0 -n "$MAX_INSN" "${EXTRA_ARGS[@]}" 2>&1 | filter_output
    ;;

  p24)
    # Pre-assembled .p24: load on pvm.s
    INPUT="${FILES[0]}"
    [ -f "$INPUT" ] || die "file not found: $INPUT"

    TMP=$(mktemp -d)
    trap "rm -rf $TMP" EXIT

    cor24-run --assemble "$PVM" "$TMP/pvm.bin" "$TMP/pvm.lst" >/dev/null 2>&1
    CODE_PTR=$(grep -A1 "code_ptr:" "$TMP/pvm.lst" | tail -1 | awk '{print $1}' | tr -d ':')
    [ -n "$CODE_PTR" ] || die "could not resolve code_ptr from pvm.lst"

    cor24-run --load-binary "$TMP/pvm.bin@0" \
      --load-binary "$INPUT@0x010000" \
      --patch "0x${CODE_PTR}=0x010000" \
      --entry 0 --speed 0 -n "$MAX_INSN" "${EXTRA_ARGS[@]}" 2>&1 | filter_output
    ;;
esac
