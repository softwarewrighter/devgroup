#!/usr/bin/env bash
# lisp24 — COR24 MacroLisp REPL and program runner
#
# Usage:
#   lisp24                     Start interactive Lisp REPL (standard prelude)
#   lisp24 <file.l24>          Load and evaluate Lisp source via UART
#   lisp24 -u '(+ 1 2)\n'     Evaluate expression in batch mode
set -euo pipefail

LIBDIR="/disk1/github/softwarewrighter/devgroup/work/lib/macrolisp"
INTERP="$LIBDIR/repl-standard.s"

ARGS=(--mode native-s --interp "$INTERP")
PROG_INPUT=""
BATCH=false

while [ $# -gt 0 ]; do
  case "$1" in
    -u)        ARGS+=(-u "$2"); BATCH=true; shift 2 ;;
    -n)        ARGS+=(-n "$2"); shift 2 ;;
    --quiet)   ARGS+=(--quiet); shift ;;
    --*)       ARGS+=("$1"); shift ;;
    *)
      if [ -f "$1" ]; then
        PROG_INPUT="$1"
      else
        echo "lisp24: file not found: $1" >&2; exit 1
      fi
      shift ;;
  esac
done

if [ -n "$PROG_INPUT" ]; then
  BATCH=true
  ARGS+=(-u "$(cat "$PROG_INPUT")"$'\n' --quiet)
fi

if $BATCH; then
  ARGS+=(--no-terminal)
else
  ARGS+=(--echo)
fi

exec cor24-interpret "${ARGS[@]}"
